package Lab1;

public class primenumbers {

	public static void main(String[] args) {
		// TODO Auto-generated method stub

            
            System.out.print("Prime Numbers from 1 - 100:\n");
            int n = 100;
            
            for (int i = 2; i <= n; i++) {
                boolean isPrime = true;

                for (int j = 2; j * j <= i; j++) {
                    if (i % j == 0) { 
                        isPrime = false;
                        break;
                    }
                }
                
                if (isPrime) {
                    System.out.print(i + " ");
	}

}}
}
