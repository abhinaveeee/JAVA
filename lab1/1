package OOPS26;

public class even {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
		
        int number = 2;

        System.out.println("Even numbers between 1 and 20:");

        do {
           
            System.out.print(number + " ");
            
            
            number += 2;
            
        } while (number <= 20); 
    }


	}

